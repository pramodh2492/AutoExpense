rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny all access to root collection by default
    match /{document=**} {
      allow read, write: if false;
    }

    // Users can only read/write their own data
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      // Transactions sub-collection with field validation
      match /transactions/{transactionId} {
        allow read: if request.auth != null && request.auth.uid == userId;
        allow create, update: if request.auth != null
          && request.auth.uid == userId
          && isValidTransaction(request.resource.data);
        allow delete: if request.auth != null && request.auth.uid == userId;
      }

      // Categories sub-collection
      match /categories/{categoryId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Budgets sub-collection
      match /budgets/{budgetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }

      // Any other nested documents under user
      match /{subcollection=**} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // ── Expense Groups ────────────────────────────────────────────────────────
    // A group is readable/joinable by anyone with its code (the code IS the secret).
    // Only members can write expenses; only the creator can close the group.

    match /groups/{code} {
      // Any signed-in user can read a group (needed to validate the code before joining)
      allow read: if request.auth != null;

      // Create: must be signed-in; createdByUid must match the caller
      allow create: if request.auth != null
        && request.resource.data.createdByUid == request.auth.uid;

      // Update: members can join (add themselves to memberUids); only creator can close
      allow update: if request.auth != null
        && (
          // Joining — only memberUids changes and the caller adds themselves
          (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['memberUids'])
            && request.auth.uid in request.resource.data.memberUids)
          // Closing — only creator can flip isClosed
          || resource.data.createdByUid == request.auth.uid
        );

      // Members sub-collection — any member can read/write their own member doc
      match /members/{uid} {
        allow read: if request.auth != null && request.auth.uid in get(/databases/$(database)/documents/groups/$(code)).data.memberUids;
        allow write: if request.auth != null && request.auth.uid == uid;
      }

      // Expenses sub-collection — any member can read and add; only payer can edit/delete
      match /expenses/{expenseId} {
        allow read: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(code)).data.memberUids;
        allow create: if request.auth != null
          && request.auth.uid in get(/databases/$(database)/documents/groups/$(code)).data.memberUids
          && request.resource.data.paidByUid == request.auth.uid;
        allow update: if request.auth != null
          && resource.data.paidByUid == request.auth.uid;
        allow delete: if request.auth != null
          && resource.data.paidByUid == request.auth.uid;
      }
    }

    // Validate transaction fields
    function isValidTransaction(data) {
      let validCategories = [
        'food', 'transport', 'shopping', 'entertainment',
        'health', 'education', 'bills', 'groceries',
        'fuel', 'travel', 'subscriptions', 'salary',
        'investment', 'rent', 'utilities', 'other'
      ];

      return data.amount is number
        && data.amount > 0
        && data.category is string
        && data.category in validCategories
        && data.keys().hasAll(['amount', 'category', 'date'])
        && data.date is timestamp;
    }
  }
}
